{
  "name": "bioit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:eu": "npm run build && npx gh-pages -d dist --nojekyll",
    "deploy:cz": "echo 'bioit.ceitec.cz' > dist/CNAME && npx gh-pages -d dist --nojekyll --repo git@github.com:BioIT-CEITEC/bioit-ceitec-landing-page-cz.git",
    "deploy": "npm run deploy:eu && npm run deploy:cz"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
